{
  "manifest_version": 3,
  "name": "Lucy YouTube Tab Reuse",
  "version": "1.5.0",
  "description": "Lets Lucy reuse an existing YouTube tab on this computer.",
  "key": "",
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "permissions": ["webNavigation", "scripting"],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
